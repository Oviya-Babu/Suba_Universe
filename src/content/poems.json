[
  {
    "id": "poem-01",
    "titleTa": "சில மனிதர்கள்",
    "titleEn": "Some people",
    "linesTa": [
      "சில மனிதர்கள் வாழ்க்கையில் வருவதில்லை...",
      "வாழ்க்கையையே அழகாக்கிவிடுகிறார்கள்.",
      "நீ வந்த பிறகு",
      "சாதாரண நாட்களும்",
      "சிறப்பு நாட்களாகிவிட்டன."
    ],
    "linesEn": [
      "Some people don't just walk into life…",
      "they make life itself beautiful.",
      "Since you arrived,",
      "even ordinary days",
      "have turned into celebrations."
    ],
    "classicEcho": ""
  },
  {
    "id": "poem-02",
    "titleTa": "நீ அருகில் இருந்தால்",
    "titleEn": "When you're near",
    "linesTa": [
      "நீ அருகில் இருந்தால்",
      "நேரம் கூட மெதுவாக நடக்கிறது.",
      "நான் பேசும் உளறல்களுக்கும்",
      "நீ காது கொடுக்கிறாய்,",
      "அதுவே எனக்கு",
      "ஆயிரம் ஆறுதல்களுக்குச் சமம்."
    ],
    "linesEn": [
      "When you're near,",
      "even time walks slowly.",
      "You listen even to my rambling,",
      "and that alone",
      "is worth a thousand comforts."
    ],
    "classicEcho": ""
  },
  {
    "id": "poem-03",
    "titleTa": "தீர்ப்பில்லாத தோழமை",
    "titleEn": "Friendship without judgment",
    "linesTa": [
      "என் எண்ணங்களை எடை போடாமல்,",
      "என் குழப்பங்களைக் குறை சொல்லாமல்,",
      "என்னை அப்படியே ஏற்றுக்கொள்ளும்",
      "உன் மனதில்",
      "நான் எப்போதும்",
      "வீடு திரும்பிய உணர்வு கொள்கிறேன்."
    ],
    "linesEn": [
      "Without weighing my thoughts,",
      "without blaming my confusion,",
      "you accept me just as I am.",
      "In your heart,",
      "I always feel like",
      "I have come home."
    ],
    "classicEcho": ""
  },
  {
    "id": "poem-04",
    "titleTa": "முடிவில்லாத உரையாடல்",
    "titleEn": "An endless conversation",
    "linesTa": [
      "ஒரு நிமிடம் பாட்டு,",
      "மறுநிமிடம் தத்துவம்,",
      "அடுத்த நிமிடம் அர்த்தமே இல்லாத சிரிப்பு,",
      "நம் பேச்சுக்கு எல்லைக்கோடே கிடையாது.",
      "",
      "சமூகம் முதல் சினிமா வரை,",
      "அரசியல் முதல் பாடல்கள் வரை,",
      "எல்லாவற்றையும் பேசித் தீர்த்தாலும்",
      "இன்னும் பேச ஏதோ மிச்சமிருக்கிறது.",
      "",
      "அதுதான் நட்பு போலும்,",
      "முடிவே இல்லாத ஓர் உரையாடல்."
    ],
    "linesEn": [
      "One minute a song,",
      "the next a philosophy,",
      "the next a laugh with no meaning at all;",
      "our talks have no boundary line.",
      "",
      "From society to cinema,",
      "from politics to music,",
      "even after we have talked everything out,",
      "something is still left to say.",
      "",
      "Maybe that is what friendship is:",
      "a conversation that never ends."
    ],
    "classicEcho": ""
  },
  {
    "id": "poem-05",
    "titleTa": "நன்றி என்ற சொல் போதாது",
    "titleEn": "A word called thanks is not enough",
    "linesTa": [
      "நன்றி என்ற ஒரே சொல்லில்",
      "உன்னை அடக்கிவிட முடியாது.",
      "நான் பேசிக்கொண்டே இருந்த நேரங்களில்",
      "நீ தந்த செவி,",
      "நான் சிரித்த நேரங்களில்",
      "நீ சேர்ந்து சிரித்த சிரிப்பு,",
      "எல்லாம் சேர்ந்துதான்",
      "என் நாட்களை அழகாக்குகின்றன."
    ],
    "linesEn": [
      "\"Thank you\" is only one word",
      "and cannot hold what you mean.",
      "The ear you gave whenever I kept talking,",
      "the laughter you shared whenever I laughed,",
      "all of it together",
      "makes my days beautiful."
    ],
    "classicEcho": ""
  },
  {
    "id": "poem-06",
    "titleTa": "பூந்தோட்டம்",
    "titleEn": "The flower garden",
    "linesTa": [
      "நட்பெனும் பூந்தோட்டத்தில்",
      "நீ ஒரு தனி மலர்;",
      "உன் மணமே",
      "என் வாழ்வின் வசந்தம்."
    ],
    "linesEn": [
      "In the garden called friendship,",
      "you are a flower apart;",
      "your fragrance",
      "is the spring of my life."
    ],
    "classicEcho": ""
  },
  {
    "id": "poem-07",
    "titleTa": "பிறந்தநாள் வாழ்த்து",
    "titleEn": "Birthday wish",
    "linesTa": [
      "சுபஸ்ரீ,",
      "நீ சிரிக்கும் ஒவ்வொரு நாளும்",
      "எனக்கும் ஒரு திருவிழா.",
      "",
      "உன் கனவுகள் ஒவ்வொன்றும்",
      "மெல்ல மெல்ல மலரட்டும்;",
      "உன் மனம் எப்போதும்",
      "அமைதியில் நிறையட்டும்;",
      "நீ கொடுக்கும் அன்பு",
      "உன்னிடமே பல மடங்காகத் திரும்பட்டும்.",
      "",
      "பிறந்தநாள் வாழ்த்துகள்,",
      "என் உயிர்த்தோழியே 💜"
    ],
    "linesEn": [
      "Chuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuba 💜,",
      "every day you smile",
      "is a festival for me too.",
      "",
      "May each of your dreams",
      "bloom slowly and beautifully;",
      "may your heart always",
      "be filled with peace;",
      "may the love you give so freely",
      "return to you a hundredfold.",
      "",
      "Happy birthday,",
      "my dearest friend 💜"
    ],
    "classicEcho": ""
  }
]
